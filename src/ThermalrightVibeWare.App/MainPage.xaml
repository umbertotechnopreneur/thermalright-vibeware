<Page x:Class="ThermalrightVibeWare.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:html="clr-namespace:CSHTML5.Native.Html.Controls;assembly=OpenSilver">
    <Page.Resources>
        <Style x:Key="BareItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch"/>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Page.Resources>
    <Grid x:Name="Root" Background="#101218">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="HeaderArea" Margin="28,16,28,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="ProductIcon" Source="/ThermalrightVibeWare.UI;component/Assets/thermalright-vibeware-icon.png" Width="62" Height="62" Stretch="Uniform" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="Eyebrow" Text="D I S P L A Y   S T U D I O" FontSize="9"/>
                    <TextBlock x:Name="Heading" Text="Thermalright VibeWare" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock x:Name="Author" Text="by Umberto Giacobbi" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeaderDot" Text="·" FontSize="10" Margin="10,0" VerticalAlignment="Center"/>
                        <HyperlinkButton x:Name="AboutLink" Content="About" Click="About_Click" FontSize="10"/>
                    </StackPanel>
                    <TextBlock x:Name="Subtitle" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid x:Name="AppearanceFrame">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AutoButton" Content="Auto" Click="Auto_Click" Width="60" Height="32"/>
                        <Button x:Name="LightButton" Content="Light" Click="Light_Click" Width="60" Height="32"/>
                        <Button x:Name="DarkButton" Content="Dark" Click="Dark_Click" Width="60" Height="32"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <HyperlinkButton x:Name="Manifesto" Content="VibeWare · Manifesto" NavigateUri="https://umbertogiacobbi.biz/vibeware/manifesto" TargetName="_blank" FontSize="10" VerticalAlignment="Center"/>
                    <HyperlinkButton x:Name="InitiativeLogo" NavigateUri="https://umbertogiacobbi.biz/vibeware/manifesto" TargetName="_blank" Margin="10,0,0,0" ToolTipService.ToolTip="VibeWare manifesto" AutomationProperties.Name="VibeWare manifesto">
                        <Image x:Name="InitiativeImage" Source="/ThermalrightVibeWare.UI;component/Assets/vibeware-logo.png" Width="36" Height="36" Stretch="Uniform"/>
                    </HyperlinkButton>
                </StackPanel>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="28,0,28,12">
            <Button x:Name="ThemesTab" Content="Themes" Click="ThemesTab_Click" Padding="12,7" Margin="0,0,12,0"/>
            <Button x:Name="SensorsTab" Content="Sensor Debug" Click="SensorsTab_Click" Padding="12,7"/>
        </StackPanel>
        <Grid x:Name="ContentArea" Grid.Row="2" Margin="28,0,28,0">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="LibraryColumn" Width="248"/><ColumnDefinition x:Name="LibraryGap" Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="LibraryFrame">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="12,2,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LibraryHeading" Text="THEME LIBRARY" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="ReloadButton" Grid.Column="1" Content="↻" Click="Reload_Click" Width="30" Height="28" ToolTipService.ToolTip="Reload themes from local folders"/>
                    </Grid>
                    <ListBox x:Name="CategoriesBox" Grid.Row="1" BorderThickness="0" Padding="0" Margin="0,0,0,20" SelectionChanged="Category_Changed" ItemContainerStyle="{StaticResource BareItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Background="Transparent" BorderBrush="{Binding Outline}" BorderThickness="0,0,0,2" Padding="8,10" Margin="0,0,4,0">
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Ink}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <ListBox x:Name="ThemesBox" Grid.Row="2" BorderThickness="0" Padding="0" SelectionChanged="Theme_Changed" ItemContainerStyle="{StaticResource BareItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Background="Transparent" BorderBrush="{Binding Outline}" BorderThickness="2,0,0,0" Padding="12,12" Margin="0,0,8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Number}" Foreground="{Binding Accent}" FontSize="11" Margin="0,3,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Foreground="{Binding Ink}" FontSize="14" FontWeight="{Binding Weight}"/>
                                        <TextBlock Text="{Binding Description}" Visibility="{Binding DescriptionVisibility}" Foreground="{Binding Muted}" FontSize="10" TextWrapping="Wrap" MaxHeight="30" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="CatalogText" Grid.Row="3" FontSize="10" Margin="14,16,0,0" Text="Discovering local themes…" TextWrapping="Wrap"/>
                    <Grid x:Name="ScreensFrame" Grid.Row="4" Margin="14,16,8,0">
                        <StackPanel>
                            <Button x:Name="ScreensDetailsButton" Content="› Screens on display" Click="Disclosure_Click" HorizontalContentAlignment="Left" Padding="0,5" FontSize="11"/>
                            <StackPanel x:Name="ScreensDetails" Visibility="Collapsed">
                            <TextBlock x:Name="ScreensHeading" Text="Allow these screens" FontSize="9" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="MusicScreenBox" Content="Music" FontSize="10" Margin="0,0,9,0" Checked="Screen_Changed" Unchecked="Screen_Changed" ToolTipService.ToolTip="Allow the selected Music theme on the display"/>
                                <CheckBox x:Name="CodexScreenBox" Content="Codex" FontSize="10" Margin="0,0,9,0" Checked="Screen_Changed" Unchecked="Screen_Changed" ToolTipService.ToolTip="Allow the selected Codex theme while Codex is running"/>
                                <CheckBox x:Name="SystemScreenBox" Content="System" FontSize="10" Checked="Screen_Changed" Unchecked="Screen_Changed" ToolTipService.ToolTip="Allow the selected System theme on the display"/>
                            </StackPanel>
                            <TextBlock x:Name="ScreensHelpText" Text="Codex hides when its process is closed. You can preview every theme." FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="CodexSetupFrame" Grid.Row="5" Margin="14,20,8,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="CodexDetailsButton" Content="› Codex connection" Click="Disclosure_Click" HorizontalContentAlignment="Left" Padding="0,5" FontSize="11"/>
                                <Button x:Name="CodexRefreshButton" Grid.Column="1" Content="↻" Click="CodexRefresh_Click" Width="26" Height="24" ToolTipService.ToolTip="Check plugin and incoming events"/>
                            </Grid>
                            <TextBlock x:Name="CodexSummaryText" Text="Checking connection…" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                            <StackPanel x:Name="CodexDetails" Visibility="Collapsed">
                            <TextBlock x:Name="CodexSetupHeading" Text="Local plugin" FontSize="9" Margin="0,8,0,0"/>
                            <TextBlock x:Name="CodexStatusText" Text="Checking the local plugin…" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock x:Name="CodexEventText" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <Button x:Name="CodexPrepareButton" Content="Prepare Codex plugin" Click="CodexPrepare_Click" Height="30" FontSize="11" Margin="0,10,0,0" ToolTipService.ToolTip="Copy the plugin locally. Finish installation and review its hooks in Codex."/>
                            <TextBlock x:Name="CodexHelpText" Text="Prepare here. Then install the plugin and review its hooks inside Codex." FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel x:Name="SensorSetupFrame" Grid.Row="5" Margin="14,16,8,0" Visibility="Collapsed">
                        <Button x:Name="SensorDetailsButton" Content="› Sensor access" Click="Disclosure_Click" HorizontalContentAlignment="Left" Padding="0,5" FontSize="11"/>
                        <TextBlock x:Name="SensorSummaryText" Text="Checking access…" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <StackPanel x:Name="SensorDetails" Visibility="Collapsed">
                        <TextBlock x:Name="SensorSetupHeading" Text="Driver details" FontSize="9" Margin="0,8,0,0"/>
                        <TextBlock x:Name="SensorDriverText" Text="CPU and motherboard temperatures and fan RPM need the PawnIO driver. Checking its installation…" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBox x:Name="SensorDriverPath" IsReadOnly="True" TextWrapping="Wrap" FontSize="9" Margin="0,8,0,0" MaxHeight="62" BorderThickness="0" Background="Transparent" Visibility="Collapsed"/>
                        <Button x:Name="SensorDriverFolderButton" Content="Open driver folder" Click="SensorDriverFolder_Click" Height="30" FontSize="11" Margin="0,10,0,0" IsEnabled="False" ToolTipService.ToolTip="Select the driver in File Explorer. This does not install or allow it."/>
                        <TextBlock x:Name="SensorDriverHelp" Text="Install PawnIO separately, then restart. Thermalright VibeWare does not install drivers." FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <StackPanel x:Name="AdministratorPanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <TextBlock x:Name="AdministratorHelp" Text="Running without administrator access." FontSize="10" TextWrapping="Wrap"/>
                            <Button x:Name="AdministratorButton" Content="Reopen as administrator" Click="Administrator_Click" Height="30" Padding="10,0" FontSize="11" Margin="0,8,0,0" ToolTipService.ToolTip="Save your choices and reopen. Themes also run as administrator."/>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="ThemeHeadingArea" Margin="2,2,2,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="CategoryText" Text="MULTIMEDIA" FontSize="10"/>
                        <TextBlock x:Name="SelectedThemeText" Text="Choose a theme" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock x:Name="ThemePagesText" FontSize="11" Margin="0,7,0,0"/>
                        <StackPanel x:Name="ArtistSourcesPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,0">
                            <HyperlinkButton x:Name="ArtistBiographyLink" Content="Artist biography" TargetName="_blank" FontSize="11" Padding="0"/>
                            <HyperlinkButton x:Name="ArtistPhotoLink" Content="Photo / license" TargetName="_blank" FontSize="11" Padding="0" Margin="16,0,0,0"/>
                            <HyperlinkButton x:Name="ArtistSalesLink" Content="Sales source" TargetName="_blank" FontSize="11" Padding="0" Margin="16,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid x:Name="PreviewBadge" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewBadgeText" Text="LOCAL PREVIEW" FontSize="10"/>
                    </Grid>
                </Grid>
                <Grid x:Name="PreviewFrame" Grid.Row="1" Margin="8,6,8,8" SizeChanged="Preview_SizeChanged">
                    <Grid x:Name="PreviewSurface" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Keep the preview backing opaque and flat, without compositing effects. -->
                        <Border x:Name="PreviewBacking" Background="#101522" Visibility="Collapsed"/>
                        <!-- Fill the arranged presenter, bypassing its auto-height inner wrapper. -->
                        <html:HtmlPresenter x:Name="PreviewImage" IsHitTestVisible="False" ScrollMode="Disabled" Html="&lt;div id='trv-preview' style='position:absolute;inset:0;overflow:hidden'&gt;&lt;canvas style='position:absolute;inset:0;width:100%;height:100%;opacity:0'&gt;&lt;/canvas&gt;&lt;canvas style='position:absolute;inset:0;width:100%;height:100%'&gt;&lt;/canvas&gt;&lt;/div&gt;"/>
                    </Grid>
                    <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="24">
                        <TextBlock x:Name="LoadingTitle" Text="Choose your display theme" FontSize="23" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LoadingText" Text="Loading the local theme engine…" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="NavigationArea" Grid.Row="2" Margin="0,10,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ThemeNavigationText" Text="THEME - Choose a theme" FontSize="9" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PreviousButton" Content="←" Click="Previous_Click" Width="38" Height="34" ToolTipService.ToolTip="Previous theme · Page Up"/>
                            <TextBlock x:Name="PositionText" Text="00 / 00" FontSize="12" VerticalAlignment="Center" Margin="12,0"/>
                            <Button x:Name="NextButton" Content="→" Click="Next_Click" Width="38" Height="34" ToolTipService.ToolTip="Next theme · Page Down"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="PageNavigationText" Text="PAGE - Main" FontSize="9" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PagePreviousButton" Content="←" Click="PagePrevious_Click" Width="38" Height="34" ToolTipService.ToolTip="Previous page"/>
                            <TextBlock x:Name="PagePositionText" Text="01 / 01" FontSize="12" VerticalAlignment="Center" Margin="12,0"/>
                            <Button x:Name="PageNextButton" Content="→" Click="PageNext_Click" Width="38" Height="34" ToolTipService.ToolTip="Next page"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="SourceText" Grid.Column="3" FontSize="11" VerticalAlignment="Center" Margin="18,14,12,0" TextTrimming="CharacterEllipsis"/>
                    <CheckBox x:Name="SpectrumBox" Grid.Column="4" Content="Spectrum" IsChecked="True" IsEnabled="False" FontSize="11" VerticalAlignment="Center" Checked="Spectrum_Changed" Unchecked="Spectrum_Changed" Margin="0,14,12,0" ToolTipService.ToolTip="Show frequency bars where the theme supports them. VU meters stay visible."/>
                    <CheckBox x:Name="CycleBox" Grid.Column="5" Content="Auto-cycle · 20s" VerticalAlignment="Center" FontSize="11" Checked="Cycle_Changed" Unchecked="Cycle_Changed" Margin="0,14,0,0" ToolTipService.ToolTip="Rotate enabled screens every 20 seconds. With one screen, rotate its themes."/>
                </Grid>
                <StackPanel Grid.Row="3">
                <Button x:Name="AppearanceDetailsButton" Content="› Appearance" Click="Disclosure_Click" HorizontalAlignment="Left" Padding="0,5" FontSize="11"/>
                <Grid x:Name="OptionsFrame" Visibility="Collapsed" Margin="0,6,0,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="FontLabel" Text="FONT FAMILY" FontSize="9" Margin="0,0,0,6"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="FontsBox" Height="32" DisplayMemberPath="Name" MaxDropDownHeight="280" SelectionChanged="FontSelection_Changed" DropDownClosed="FontMenu_Closed" Visibility="Collapsed" ToolTipService.ToolTip="Installed monospace fonts"/>
                                <TextBox x:Name="FontBox" Text="Cascadia Mono" Height="32" Padding="8,6" FontSize="12" KeyDown="Font_KeyDown"/>
                                <Button x:Name="ApplyFontButton" Grid.Column="1" Content="Apply" Click="Font_Click" Height="32" Margin="6,0,0,0" Padding="10,0"/>
                                <Button x:Name="FontListButton" Grid.Column="2" Content="≡" Click="FontList_Click" Width="28" Height="32" Margin="4,0,0,0" IsEnabled="False" ToolTipService.ToolTip="Choose an installed monospace font"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock x:Name="SizeLabel" Text="TEXT SIZE" FontSize="9" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SmallerButton" Content="−" Width="28" Height="32" Click="Smaller_Click"/>
                                <TextBlock x:Name="FontScaleText" Text="100%" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
                                <Button x:Name="LargerButton" Content="+" Width="28" Height="32" Click="Larger_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="GeometryLabel" Text="PANEL SIZE" FontSize="9" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ProfilesBox" Width="166" Height="32" DisplayMemberPath="Name" SelectionChanged="Profile_Changed" ToolTipService.ToolTip="Auto size reads the panel dimensions when you press Show on display"/>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="FiltersPanel" Grid.Row="1" Padding="14,10" CornerRadius="8" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox x:Name="FiltersBox" Content="Color filters" FontSize="12" Checked="Filters_Changed" Unchecked="Filters_Changed" ToolTipService.ToolTip="Turn off to skip color processing. Your slider values are kept."/>
                                <TextBlock x:Name="FiltersStatus" Grid.Column="1" Text="Off · original colors" FontSize="10" Margin="14,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="PaletteButton" Content="Theme colors" Click="Palette_Click" Height="26" Padding="10,0" Margin="0,0,8,0"/><Button x:Name="ResetColorsButton" Content="Reset" Click="ResetColors_Click" Height="26" Padding="10,0" Visibility="Collapsed" ToolTipService.ToolTip="Restore the four original color values"/></StackPanel>
                            </Grid>
                            <Grid x:Name="ColorControls" Margin="0,10,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="HueLabel" Text="HUE" FontSize="9"/>
                                        <TextBlock x:Name="HueText" Grid.Column="1" Text="0°" FontSize="11"/>
                                    </Grid>
                                    <Slider x:Name="HueSlider" Minimum="-180" Maximum="180" Value="0" SmallChange="1" LargeChange="15" Height="24" ValueChanged="Color_Changed" ToolTipService.ToolTip="Shift the colors · 0° keeps the original hues" AutomationProperties.Name="Hue"/>
                                    <Border x:Name="HueRamp" Height="6" CornerRadius="3" Margin="8,3,8,0" IsHitTestVisible="False"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="SaturationLabel" Text="SATURATION" FontSize="9"/>
                                        <TextBlock x:Name="SaturationText" Grid.Column="1" Text="100%" FontSize="11"/>
                                    </Grid>
                                    <Slider x:Name="SaturationSlider" Minimum="0" Maximum="200" Value="100" SmallChange="1" LargeChange="10" Height="24" ValueChanged="Color_Changed" ToolTipService.ToolTip="0% grayscale · 100% original · 200% stronger color" AutomationProperties.Name="Saturation"/>
                                    <Border x:Name="SaturationRamp" Height="6" CornerRadius="3" Margin="8,3,8,0" IsHitTestVisible="False"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,18,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="BrightnessLabel" Text="BRIGHTNESS" FontSize="9"/>
                                        <TextBlock x:Name="BrightnessText" Grid.Column="1" Text="0%" FontSize="11"/>
                                    </Grid>
                                    <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Value="0" SmallChange="1" LargeChange="10" Height="24" ValueChanged="Color_Changed" ToolTipService.ToolTip="Lower or raise brightness · 0% keeps the original level" AutomationProperties.Name="Brightness"/>
                                    <Border x:Name="BrightnessRamp" Height="6" CornerRadius="3" Margin="8,3,8,0" IsHitTestVisible="False"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ContrastLabel" Text="CONTRAST" FontSize="9"/>
                                        <TextBlock x:Name="ContrastText" Grid.Column="1" Text="100%" FontSize="11"/>
                                    </Grid>
                                    <Slider x:Name="ContrastSlider" Minimum="0" Maximum="200" Value="100" SmallChange="1" LargeChange="10" Height="24" ValueChanged="Color_Changed" ToolTipService.ToolTip="100% keeps the original contrast" AutomationProperties.Name="Contrast"/>
                                    <Border x:Name="ContrastRamp" Height="6" CornerRadius="3" Margin="8,3,8,0" IsHitTestVisible="False"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
                </StackPanel>
                <Grid x:Name="DisplayFrame" Grid.Row="4">
                    <Border x:Name="DisplayDivider" BorderThickness="0,1,0,0" VerticalAlignment="Top"/>
                    <Grid x:Name="DisplayControls" Margin="0,16,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel x:Name="DeviceField" Margin="0,0,6,0">
                            <TextBlock x:Name="DeviceLabel" Text="USB DISPLAY" FontSize="9" Margin="0,0,0,6"/>
                            <ComboBox x:Name="DevicesBox" Height="32" MinWidth="100" DisplayMemberPath="Name" SelectionChanged="Device_Changed"/>
                        </StackPanel>
                        <Button x:Name="RefreshDevicesButton" Grid.Column="1" Content="↻" Click="RefreshDevices_Click" Width="30" Height="32" Margin="0,0,12,0" VerticalAlignment="Bottom" ToolTipService.ToolTip="Find connected displays"/>
                        <StackPanel x:Name="DisplayOptionsPanel" Grid.Row="2" Grid.ColumnSpan="6" Orientation="Horizontal" Visibility="Collapsed" Margin="0,8,0,0">
                        <StackPanel x:Name="RefreshField" Margin="0,0,12,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="RefreshLabel" Text="UPDATE" FontSize="9" Margin="0,0,0,6"/>
                            <ComboBox x:Name="RefreshBox" Width="94" Height="32" DisplayMemberPath="Name" SelectionChanged="Refresh_Changed" ToolTipService.ToolTip="Requested interval. 25 ms is aggressive; actual updates depend on rendering and USB."/>
                        </StackPanel>
                        <StackPanel x:Name="QualityField" Margin="0,0,12,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="QualityLabel" Text="JPEG QUALITY" FontSize="9" Margin="0,0,0,6"/>
                            <ComboBox x:Name="QualityBox" Width="94" Height="32" DisplayMemberPath="Name" SelectionChanged="Quality_Changed" ToolTipService.ToolTip="Poor uses very strong JPEG compression."/>
                        </StackPanel>
                        </StackPanel>
                        <Button x:Name="DisplayOptionsButton" Grid.Row="1" Grid.ColumnSpan="6" Content="› Display options" Click="Disclosure_Click" HorizontalAlignment="Left" Padding="0,5" FontSize="11" Margin="0,6,0,0"/>
                        <Button x:Name="StartDisplayButton" Grid.Column="4" Content="Show on display" Click="StartDisplay_Click" Height="32" Padding="12,0" Margin="0,0,6,0" VerticalAlignment="Bottom"/>
                        <Button x:Name="StopDisplayButton" Grid.Column="5" Content="Stop" Click="StopDisplay_Click" Height="32" Padding="12,0" VerticalAlignment="Bottom" IsEnabled="False"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="SensorDebugPanel" Grid.Row="2" Margin="28,0" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,10">
                    <TextBlock x:Name="SensorDebugHeading" Text="Sensor Debug" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SensorDebugSummary" Text="Read the devices and values available from Libre Hardware Monitor." FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="SensorDebugAdministrator" Content="Reopen as administrator" Click="Administrator_Click" Padding="12,7" Margin="0,0,12,0" ToolTipService.ToolTip="Save choices and reopen in preview. Themes also run as administrator."/>
                    <Button x:Name="SensorDebugRefresh" Content="Refresh readings" Click="SensorDebugRefresh_Click" Padding="12,7"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="SensorDebugNotice" Grid.Row="1" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="SensorDebugHelp" Grid.Row="2" Text="Device → sensor type → sensor. Columns: current, minimum, maximum. Values are read-only. Refresh samples on demand; missing readings remain unavailable." FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TreeView x:Name="SensorDebugTree" Grid.Row="3" BorderThickness="0" Padding="0"/>
        </Grid>
        <Grid x:Name="FooterArea" Grid.Row="3" Margin="28,12,28,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Local preview" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Text, ElementName=StatusText}"/>
            <Button x:Name="DiagnosticsDetailsButton" Grid.Column="2" Content="› Diagnostics" Click="Disclosure_Click" FontSize="10" Padding="8,4"/>
            <StackPanel x:Name="DiagnosticsDetails" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" MaxWidth="420">
                <TextBlock x:Name="TimingDetailsText" FontSize="10" TextWrapping="Wrap" Margin="12,4,0,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="LogErrorsBox" Content="Log errors" FontSize="10" VerticalAlignment="Center" Margin="12,0" Checked="Diagnostics_Changed" Unchecked="Diagnostics_Changed" ToolTipService.ToolTip="Local technical events only. No song titles, prompts, audio or transcripts."/>
                <Button x:Name="OpenLogButton" Content="Open log" Click="OpenLog_Click" FontSize="10" Padding="8,4" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="FooterLinks" Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <HyperlinkButton x:Name="TermsLink" Content="Terms" NavigateUri="https://umbertogiacobbi.biz/terms/" TargetName="_blank" FontSize="10"/>
                    <TextBlock x:Name="FooterDot2" Text=" · " FontSize="10" VerticalAlignment="Center" Margin="6,0"/>
                    <HyperlinkButton x:Name="PrivacyLink" Content="Privacy" NavigateUri="https://umbertogiacobbi.biz/privacy/" TargetName="_blank" FontSize="10"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="PaletteOverlay" Grid.RowSpan="4" Background="#B0000000" Visibility="Collapsed">
            <Border x:Name="PaletteFrame" Width="440" Padding="24" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <StackPanel>
                    <TextBlock x:Name="PaletteHeading" FontSize="18" Text="Theme colors" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PaletteHelp" Text="Use #RRGGBB. Leave empty to inherit the theme color. Saved for this theme and appearance." TextWrapping="Wrap" Margin="0,10,0,14"/>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock x:Name="PalettePrimaryLabel" Text="Primary text" VerticalAlignment="Center"/><TextBox x:Name="PalettePrimary" Grid.Column="1" MaxLength="7" Height="30"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock x:Name="PaletteSecondaryLabel" Text="Secondary text" VerticalAlignment="Center"/><TextBox x:Name="PaletteSecondary" Grid.Column="1" MaxLength="7" Height="30"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock x:Name="PaletteAccentLabel" Text="Accent" VerticalAlignment="Center"/><TextBox x:Name="PaletteAccent" Grid.Column="1" MaxLength="7" Height="30"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock x:Name="PaletteWarningLabel" Text="Warning" VerticalAlignment="Center"/><TextBox x:Name="PaletteWarning" Grid.Column="1" MaxLength="7" Height="30"/></Grid>
                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock x:Name="PaletteInfoLabel" Text="Info" VerticalAlignment="Center"/><TextBox x:Name="PaletteInfo" Grid.Column="1" MaxLength="7" Height="30"/></Grid>
                    <TextBlock x:Name="PaletteError" TextWrapping="Wrap" Margin="0,10"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PaletteReset" Content="Reset" Click="ResetPalette_Click" Padding="10,6" Margin="0,0,8,0"/>
                        <Button x:Name="PaletteCancel" Content="Cancel" Click="ClosePalette_Click" Padding="10,6" Margin="0,0,8,0"/>
                        <Button x:Name="PaletteApply" Content="Apply" Click="ApplyPalette_Click" Padding="10,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="AboutOverlay" Grid.RowSpan="4" Background="#B0000000" Visibility="Collapsed">
            <Border x:Name="AboutFrame" Width="550" MaxWidth="600" Padding="30" CornerRadius="20" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <StackPanel>
                    <TextBlock x:Name="AboutHeading" Text="Thermalright VibeWare" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AboutVersion" Text="Display studio" FontSize="11" Margin="0,7,0,20"/>
                    <TextBlock x:Name="AboutAuthor" Text="I am Umberto Giacobbi. I created Thermalright VibeWare to make my small display useful, personal and beautiful." TextWrapping="Wrap" FontSize="13"/>
                    <TextBlock x:Name="AboutDisclosureHeading" Text="This is VibeWare" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,10"/>
                    <TextBlock x:Name="AboutDisclosure" Text="I created this software with AI assistance. I define its purpose, guide the implementation, and take responsibility for checking functionality, performance, and security." TextWrapping="Wrap" FontSize="12"/>
                    <TextBlock x:Name="AboutInitiative" Text="An independent hobby project, provided as is without warranty. I do not work for Thermalright and am not affiliated with or sponsored by it. All trademarks and registered trademarks belong to their respective owners." TextWrapping="Wrap" FontSize="12" Margin="0,12,0,14"/>
                    <HyperlinkButton x:Name="AboutManifesto" Content="Read the VibeWare manifesto" NavigateUri="https://umbertogiacobbi.biz/vibeware/manifesto" TargetName="_blank" HorizontalAlignment="Left" FontSize="12"/>
                    <HyperlinkButton x:Name="ProjectLink" Content="Thermalright VibeWare on GitHub" NavigateUri="https://github.com/umbertotechnopreneur/thermalright-vibeware" TargetName="_blank" HorizontalAlignment="Left" FontSize="12" Margin="0,10,0,0"/>
                    <HyperlinkButton x:Name="InitiativeLink" Content="VibeWare on GitHub" NavigateUri="https://github.com/umbertotechnopreneur/VibeWare" TargetName="_blank" HorizontalAlignment="Left" FontSize="12" Margin="0,6,0,0"/>
                    <HyperlinkButton x:Name="WebsiteLink" Content="umbertogiacobbi.biz" NavigateUri="https://umbertogiacobbi.biz" TargetName="_blank" HorizontalAlignment="Left" FontSize="12" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,16">
                        <HyperlinkButton x:Name="AboutTerms" Content="Terms" NavigateUri="https://umbertogiacobbi.biz/terms/" TargetName="_blank" FontSize="11" Margin="0,0,14,0"/>
                        <HyperlinkButton x:Name="AboutPrivacy" Content="Privacy" NavigateUri="https://umbertogiacobbi.biz/privacy/" TargetName="_blank" FontSize="11"/>
                    </StackPanel>
                    <Button x:Name="CloseAboutButton" Content="Close" Click="CloseAbout_Click" Height="36"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="CloseOverlay" Grid.RowSpan="4" Background="#B0000000" Visibility="Collapsed">
            <Border x:Name="CloseFrame" Width="480" Padding="24" CornerRadius="12" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <StackPanel>
                    <TextBlock x:Name="CloseHeading" Text="Close Thermalright VibeWare?" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CloseDescription" Text="Minimize to tray keeps your display running. Close app stops it." FontSize="13" TextWrapping="Wrap" Margin="0,12,0,24"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelCloseButton" Content="Cancel" Click="CancelClose_Click" Height="34" Padding="12,0" Margin="0,0,8,0"/>
                        <Button x:Name="ExitButton" Content="Close app" Click="Exit_Click" Height="34" Padding="12,0" Margin="0,0,8,0"/>
                        <Button x:Name="MinimizeTrayButton" Content="Minimize to tray" Click="MinimizeTray_Click" Height="34" Padding="12,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
