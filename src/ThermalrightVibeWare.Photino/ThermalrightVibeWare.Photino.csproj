<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ThermalrightVibeWare</AssemblyName>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>../ThermalrightVibeWare.App/Assets/thermalright-vibeware.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenSilver.Photino" Version="3.3.3" />
    <ProjectReference Include="../ThermalrightVibeWare.App/ThermalrightVibeWare.App.csproj" />
    <Content Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../ThermalrightVibeWare.App/Assets/thermalright-vibeware.ico" Link="Assets/thermalright-vibeware.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../ThermalrightVibeWare.App/Assets/thermalright-vibeware-icon.png" Link="Assets/thermalright-vibeware-icon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <PatchedPhotinoArchitecture Condition="'$(Platform)' == 'ARM64'">ARM64</PatchedPhotinoArchitecture>
    <PatchedPhotinoArchitecture Condition="'$(PatchedPhotinoArchitecture)' == ''">x64</PatchedPhotinoArchitecture>
    <PatchedPhotinoRoot>$(MSBuildProjectDirectory)/../../artifacts/native/photino-memory/$(PatchedPhotinoArchitecture)</PatchedPhotinoRoot>
  </PropertyGroup>
  <Target Name="BuildPatchedWindowsPhotino" BeforeTargets="PrepareForBuild" Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../scripts/build/Build-PhotinoNative.ps1&quot; -Architecture $(PatchedPhotinoArchitecture)" />
  </Target>
  <Target Name="CopyPatchedWindowsPhotino" AfterTargets="CopyFilesToOutputDirectory;Publish" DependsOnTargets="BuildPatchedWindowsPhotino" Condition="$([MSBuild]::IsOSPlatform('Windows')) and '$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(PatchedPhotinoRoot)/Photino.Native.dll" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="$(PatchedPhotinoRoot)/Photino.Native.dll" DestinationFolder="$(TargetDir)runtimes/win-$([System.String]::Copy('$(PatchedPhotinoArchitecture)').ToLowerInvariant())/native/" Condition="Exists('$(TargetDir)runtimes')" />
    <Copy SourceFiles="$(PatchedPhotinoRoot)/Photino.Native.dll" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != '' and Exists('$(PublishDir)')" />
  </Target>
</Project>
